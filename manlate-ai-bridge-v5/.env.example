# Copiar a .env y completar. No guardar secretos aquí.
OAUTH_CLIENT_ID=
OAUTH_ALLOWED_SUB=
BRIDGE_PUBLIC_URL=https://bridge-v5.example.invalid
OAUTH_AUTHORIZATION_SERVER_URL=https://authentik.example.invalid/application/o/bridge/
GITHUB_ALLOWED_REPOSITORIES=Manlate823/CryApp_Truenas_Scarlet
GITHUB_ALLOWED_BRANCHES=desarrollo/manlate-ai-bridge-v5
CRYAPP_DEV_PATH=/mnt/Almacenamiento_HDD/BaseDatos/CryApp_Bridge_DEV
CRYAPP_CODE_PATH=/mnt/Almacenamiento_HDD/BaseDatos/CryApp_Bridge_DEV/codigo
LEGACY_MEMORY_DB_PATH=/mnt/Almacenamiento_HDD/Manlate_AI_Bridge/base_datos/memoria.sqlite
OAUTH_CLIENT_SECRET_PATH=./secrets/oauth_client_secret
GITHUB_TOKEN_PATH=./secrets/github_token
BRIDGE_SSH_KEY_PATH=./secrets/bridge_ssh_key
BRIDGE_KNOWN_HOSTS_PATH=./secrets/bridge_known_hosts
BRIDGE_SHELL_ENABLED=false
BRIDGE_SSH_HOST=
